# ============================================================
#  Satly - ortam değişkenleri
#  Bu dosyayı ".env.local" olarak kopyalayın ve doldurun.
#  Anahtar yoksa uygulama "demo modu"nda sahte çıktı üretir.
# ============================================================

# --- OpenAI (zorunlu, gerçek üretim için) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Supabase (hesap/abonelik için - ikinci aşama) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ödeme (üçüncü aşama) ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
